[Actions]

# Remove utility metadata such that they can be regenerated and avoid conflicts between versions

Execute:Namespace="<MODULE-NAMESPACE-UPPERCASE>",ClassName="%pkg.isc.rest.resourceMap",MethodName="%KillExtent"

Execute:Namespace="<MODULE-NAMESPACE-UPPERCASE>",ClassName="%pkg.isc.rest.actionMap",MethodName="%KillExtent"



# Add package mapping to HSSYS to support net new dependency code

CreateMapPackage:Namespace="HSSYS",Name="%pkg.isc.changehistory",Database=<MODULE-NAMESPACE-UPPERCASE>-SOURCE

CreateMapPackage:Namespace="HSSYS",Name="HS.HC.ChangeHistory",Database=<MODULE-NAMESPACE-UPPERCASE>-SOURCE



# Install module into the module namespace using local tarball

Execute:Namespace="<MODULE-NAMESPACE-UPPERCASE>",ClassName="%IPM.Main",MethodName="Shell",Arg1="update -path <path-and-filename-of-module-artifact> -verbose -DNoLock=1 -DNoTransaction=1 -DNoMapping=1 -DIgnoreInstalled=1 healthshare_ai_assistant"



# Run module specific configurations - this is typically installer code

Execute:Namespace="<MODULE-NAMESPACE-UPPERCASE>",ClassName="%IPM.Main",MethodName="Shell",Arg1="healthshare_ai_assistant UpgradeComponent -verbose"

